# =============================================================================
# ZaraiLink Backend Environment Variables
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# =============================================================================

# ── Django Core ───────────────────────────────────────────────────────────────
# Auto-generated by setup script. Generate manually with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-random-secret-key

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Default local dev config — matches settings.py hardcoded values.
# Change these only if your PostgreSQL setup differs.
DB_NAME=zarailink
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ── OpenSearch ────────────────────────────────────────────────────────────────
# Required for search to work. Run via Docker:
#   docker run -d --name opensearch -p 9200:9200 -p 9600:9600 \
#     -e "discovery.type=single-node" -e "DISABLE_SECURITY_PLUGIN=true" \
#     opensearchproject/opensearch:2.11.0
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
SEARCH_USE_OPENSEARCH=true

# ── Redis (optional — auto-detected) ─────────────────────────────────────────
# If Redis is running on 127.0.0.1:6379 it is used for caching automatically.
# If not available, falls back to in-memory cache (slower but functional).
# Start via Docker: docker run -d --name zarailink-redis -p 6379:6379 redis:7-alpine

# ── Frontend URL ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Optional: OpenAI (AI-powered search suggestions) ─────────────────────────
# Leave blank to disable. Uses gpt-4o-mini + text-embedding-3-small.
OPENAI_KEY=

# ── Optional: Email (account verification, password reset) ───────────────────
# Leave blank to disable email sending (email verification links printed to console).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
